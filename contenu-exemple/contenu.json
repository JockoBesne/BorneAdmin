    {
      "id": "page-exemple-2",
      "titre": "Du télégraphe à la fibre",
      "modele": "t2",
      "ordre": 2,
      "vignette": null,
      "contenu": {
        "modele": "t2",
        "largeurs": {
          "galerie": 12,
          "image": 11,
          "texte": 3
        },
        "emplacements": {
          "titre": {
            "type": "titre",
            "valeur": "Du télégraphe Chappe à la fibre optique"
          },
          "image": {
            "type": "image",
            "mediaId": "media-onde",
            "legende": "Deux siècles de transmission du signal."
          },
          "texte": {
            "type": "texte",
            "valeur": "En 1794, la première ligne de **télégraphe Chappe** relie Paris à Lille. Le message met une quinzaine de minutes à parcourir deux cent trente kilomètres, de tour en tour, à la vitesse du bras articulé et de la lunette d'approche.\n\nDeux siècles plus tard, la même distance est franchie par un signal lumineux en un millième de seconde.\n\nEntre les deux, chaque génération a résolu le même problème : _porter une information plus loin, plus vite, et sans l'abîmer en chemin_.\n\n- 1794 — télégraphe optique\n- 1844 — télégraphe électrique\n- 1906 — première liaison en phonie\n- 1980 — fibre optique en service"
          },
          "galerie": {
            "type": "galerie",
            "elements": [
              {
                "mediaId": "media-galerie-1",
                "legende": "Poste radio de campagne"
              },
